void cmd(uint8_t c) {
  Wire.beginTransmission(ADDR);
  Wire.write(0x00);
  Wire.write(c);
  Wire.endTransmission();
}

void clearScreen() {
  cmd(0x21); cmd(0); cmd(127);
  cmd(0x22); cmd(0); cmd(7);
  for (int i = 0; i < 64; i++) {
    Wire.beginTransmission(ADDR);
    Wire.write(0x40);
    for (int j = 0; j < 16; j++) Wire.write((uint8_t)0);
    Wire.endTransmission();
  }
}

void printText(uint8_t col, uint8_t page, const char *s) {
  cmd(0x21); cmd(col); cmd(127);
  cmd(0x22); cmd(page); cmd(7);
  for (; *s; s++) {
    char c = toupper(*s);
    const char *p = strchr(CHARS, c);
    uint8_t idx = p ? p - CHARS : 0;
    Wire.beginTransmission(ADDR);
    Wire.write(0x40);
    for (uint8_t i = 0; i < 5; i++) Wire.write(pgm_read_byte(&FONT[idx][i]));
    Wire.write((uint8_t)0);
    Wire.endTransmission();
  }
}

// Writes one full 21-character line (pads with spaces to erase old text)
void showLine(uint8_t page, const char *s) {
  char buf[22];
  snprintf(buf, sizeof(buf), "%-21s", s);
  printText(0, page, buf);
}

// ---------- Your project ----------
const int ldrSamplePin = A0;
const int ldrRefPin    = A1;

const int led1Pin      = 9;
const int led2Pin      = 10;

const int btnPowerPin    = 2;
const int btnVoltUpPin   = 3;
const int btnVoltDownPin = 4;

bool systemOn        = false;
float setVoltage     = 12.0;
const float minVolt  = 1.0;
const float maxVolt  = 200.0;
const float voltStep = 1.0;
const float channelL = 5.0;

void setup() {
  Serial.begin(9600);
  Wire.begin();

  pinMode(led1Pin, OUTPUT);
  pinMode(led2Pin, OUTPUT);
  digitalWrite(led1Pin, LOW);
  digitalWrite(led2Pin, LOW);

  pinMode(btnPowerPin, INPUT_PULLUP);
  pinMode(btnVoltUpPin, INPUT_PULLUP);
  pinMode(btnVoltDownPin, INPUT_PULLUP);

  uint8_t init[] = {0xAE,0xD5,0x80,0xA8,0x3F,0xD3,0x00,0x40,0x8D,0x14,
                    0x20,0x00,0xA1,0xC8,0xDA,0x12,0x81,0xCF,0xD9,0xF1,
                    0xDB,0x40,0xA4,0xA6,0xAF};
  for (uint8_t i = 0; i < sizeof(init); i++) cmd(init[i]);
  clearScreen();

  showLine(0, "2-LDR TEST READY");
  showLine(1, "D2: ON/OFF");
  showLine(2, "D3/D4: VOLT +/-");
  delay(1000);
  clearScreen();
}

void loop() {
  if (digitalRead(btnPowerPin) == LOW) {
    systemOn = !systemOn;
    delay(250);
    while (digitalRead(btnPowerPin) == LOW) delay(10);
  }

  if (digitalRead(btnVoltUpPin) == LOW) {
    setVoltage += voltStep;
    if (setVoltage > maxVolt) setVoltage = maxVolt;
    delay(150);
  }

  if (digitalRead(btnVoltDownPin) == LOW) {
    setVoltage -= voltStep;
    if (setVoltage < minVolt) setVoltage = minVolt;
    delay(150);
  }

  char a[12], b[12], line[22];

  if (!systemOn) {
    digitalWrite(led1Pin, LOW);
    digitalWrite(led2Pin, LOW);

    dtostrf(setVoltage, 0, 1, a);
    showLine(0, "MODE: OFF");
    showLine(1, "---------------------");
    snprintf(line, sizeof(line), "SET VOLT: %s V", a);
    showLine(2, line);
    showLine(3, "");
    showLine(4, "PRESS D2 TO TURN ON");
  } else {
    digitalWrite(led1Pin, HIGH);
    digitalWrite(led2Pin, HIGH);
    delay(40);

    int rawSample = analogRead(ldrSamplePin);
    int rawRef    = analogRead(ldrRefPin);
    if (rawRef < 1) rawRef = 1;

    float transmittance = (float)rawSample / (float)rawRef;
    float electricField = setVoltage / channelL;
    float calcResult    = (1.0 - transmittance) * electricField * 100.0;

    dtostrf(setVoltage, 0, 0, a);
    dtostrf(electricField, 0, 1, b);
    snprintf(line, sizeof(line), "ON %sV E:%sV/CM", a, b);
    showLine(0, line);
    showLine(1, "---------------------");

    snprintf(line, sizeof(line), "A0:%d  A1:%d", rawSample, rawRef);
    showLine(2, line);

    dtostrf(transmittance * 100.0, 0, 1, a);
    snprintf(line, sizeof(line), "TRANSM: %s%%", a);
    showLine(3, line);

    dtostrf(calcResult, 0, 2, a);
    snprintf(line, sizeof(line), "RESULT: %s", a);
    showLine(4, line);

    Serial.print("V=");
    Serial.print(setVoltage, 1);
    Serial.print(" A0=");
    Serial.print(rawSample);
    Serial.print(" A1=");
    Serial.print(rawRef);
    Serial.print(" Transm%=");
    Serial.print(transmittance * 100.0, 1);
    Serial.print(" Result=");
    Serial.println(calcResult, 2);
  }

  delay(80);
}

